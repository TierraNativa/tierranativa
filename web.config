<?xml version="1.0" encoding="UTF-8"?>
<!--
  Config de IIS para servir el sitio desde IIS (SolidCP).
  En GitHub Pages este archivo es inerte; en IIS manda.

  Sin el <staticContent> IIS devuelve 404 para toda extension que no tenga
  declarada (.webp/.avif/.woff2/.json).

  Cache: los .js/.css/.webp llevan ?v=XXX (los invalida el hook al cambiar), asi
  que van con cache de un anio. Los .html NO llevan ?v=, asi que se sirven SIN
  cache (si no, el navegador queda pegado al HTML viejo y no ve los deploys).

  OJO SI EL DESPLIEGUE USA ESPEJO (robocopy /MIR, rsync --delete): pisa/borra el
  web.config del server. Con Upload comun no pasa.
-->
<configuration>
  <system.webServer>

    <!-- HTTPS obligatorio (necesario tambien para la camara del lector QR) -->
    <rewrite>
      <rules>
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>

    <!-- Tipos que IIS no conoce de fabrica + cache largo (assets versionados) -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".avif" />
      <mimeMap fileExtension=".avif" mimeType="image/avif" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <clientCache cacheControlMode="UseMaxAge"
                   cacheControlMaxAge="365.00:00:00" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <!-- X-Frame-Options SAMEORIGIN se reemplaza por CSP frame-ancestors (Tomás G, 05/11/2026, aprobado D10): SAMEORIGIN
             bloquea embeber este admin en GT Admin (otro origen). frame-ancestors permite SÓLO el propio sitio y GT, así el
             módulo "Cargar pedido" de GT (loekemeyer.github.io) puede embeber la carga de pedidos, sin abrir el framing a todos. -->
        <add name="Content-Security-Policy" value="frame-ancestors 'self' https://loekemeyer.github.io" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!-- Los .html NO se cachean: el HTML no tiene ?v=, y referencia los ?v= de
       js/css. Si se cacheara un anio, el navegador nunca veria un deploy nuevo. -->
  <location path="index.html">
    <system.webServer><staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent></system.webServer>
  </location>
  <location path="mayorista.html">
    <system.webServer><staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent></system.webServer>
  </location>
  <location path="historial.html">
    <system.webServer><staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent></system.webServer>
  </location>
  <location path="sugerencias.html">
    <system.webServer><staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent></system.webServer>
  </location>
  <location path="admin.html">
    <system.webServer><staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent></system.webServer>
  </location>

</configuration>
